{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIペイント",
  "version": "1.0.1",
  "identifier": "jp.pixelpassion.aipaint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIペイント",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main", "chat"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://localhost:1420 http://127.0.0.1:1420",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["aipaint"],
        "name": "AI Paint Document",
        "description": "AI Paint ドキュメント",
        "role": "Editor",
        "mimeType": "application/x-ai-paint"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ja-JP",
        "upgradeCode": "348cb9ac-27c2-59b0-9fa4-563c9e559b0a"
      }
    }
  }
}
